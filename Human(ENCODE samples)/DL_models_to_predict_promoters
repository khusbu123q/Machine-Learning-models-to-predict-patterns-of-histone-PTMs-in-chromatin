def to_tensors(X, y):
    return (torch.tensor(X, dtype=torch.float32),
            torch.tensor(y, dtype=torch.float32).unsqueeze(1))


def make_loader(X, y, batch_size=64, shuffle=True):
    ds = TensorDataset(*to_tensors(X, y))
    return DataLoader(ds, batch_size=batch_size, shuffle=shuffle)


class FFN(nn.Module):
    def __init__(self, in_features: int, hidden: list[int] = [256, 128, 64],
                 dropout: float = 0.3):
        super().__init__()
        layers = []
        prev = in_features
        for h in hidden:
            layers += [
                nn.Linear(prev, h),
                nn.BatchNorm1d(h),
                nn.GELU(),
                nn.Dropout(dropout),
            ]
            prev = h
        self.body = nn.Sequential(*layers)
        self.head = nn.Linear(prev, 1)
        self.skip = (nn.Linear(in_features, hidden[-1])
                     if in_features != hidden[-1] else nn.Identity())

    def forward(self, x):
        out = x
        for i, layer in enumerate(self.body):
            out = layer(out)
            if i == len(self.body) - 1:
                out = out + self.skip(x)
        return self.head(out)


class CNN1D(nn.Module):
    def __init__(self, in_features: int, channels: list[int] = [64, 128, 64],
                 dropout: float = 0.3):
        super().__init__()
        self.conv_blocks = nn.ModuleList()
        prev_c = 1
        for c in channels:
            block = nn.Sequential(
                nn.Conv1d(prev_c, c, kernel_size=3, padding=1),
                nn.BatchNorm1d(c),
                nn.GELU(),
                nn.Dropout(dropout),
            )
            self.conv_blocks.append(block)
            prev_c = c
        self.pool = nn.AdaptiveAvgPool1d(1)
        self.head = nn.Linear(channels[-1], 1)

    def forward(self, x):
        out = x.unsqueeze(1)
        for block in self.conv_blocks:
            out = block(out)
        out = self.pool(out).squeeze(-1)
        return self.head(out)


def train_model(model, train_loader, val_loader,
                epochs: int = 150, patience: int = 20,
                lr: float = 1e-3, weight_decay: float = 1e-4):
    model.to(DEVICE)
    optimiser = torch.optim.Adam(model.parameters(), lr=lr, weight_decay=weight_decay)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
        optimiser, T_max=epochs, eta_min=lr * 0.01
    )
    criterion = nn.MSELoss()

    best_val_loss = float("inf")
    best_state    = None
    no_improve    = 0

    for epoch in range(1, epochs + 1):
        model.train()
        train_loss = 0.0
        for Xb, yb in train_loader:
            Xb, yb = Xb.to(DEVICE), yb.to(DEVICE)
            optimiser.zero_grad()
            loss = criterion(model(Xb), yb)
            loss.backward()
            nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            optimiser.step()
            train_loss += loss.item() * len(Xb)

        scheduler.step()
        train_loss /= len(train_loader.dataset)

        model.eval()
        val_loss = 0.0
        with torch.no_grad():
            for Xb, yb in val_loader:
                Xb, yb = Xb.to(DEVICE), yb.to(DEVICE)
                val_loss += criterion(model(Xb), yb).item() * len(Xb)
        val_loss /= len(val_loader.dataset)

        if val_loss < best_val_loss:
            best_val_loss = val_loss
            best_state    = {k: v.cpu().clone() for k, v in model.state_dict().items()}
            no_improve    = 0
        else:
            no_improve += 1

        if epoch % 25 == 0 or epoch == 1:
            print(f"  Epoch {epoch:>3}/{epochs}  "
                  f"train={train_loss:.4f}  val={val_loss:.4f}  "
                  f"lr={scheduler.get_last_lr()[0]:.2e}")

        if no_improve >= patience:
            print(f"  Early stop at epoch {epoch}")
            break

    model.load_state_dict(best_state)
    return model


def predict_np(model, X_sc: np.ndarray) -> np.ndarray:
    model.eval()
    t = torch.tensor(X_sc, dtype=torch.float32).to(DEVICE)
    with torch.no_grad():
        return model(t).cpu().numpy().ravel()


def cross_val_r2(model_cls, model_kwargs, X_sc, y_np, k: int = 5, **train_kwargs) -> float:
    kf  = KFold(n_splits=k, shuffle=True, random_state=SEED)
    r2s = []
    for tr, va in kf.split(X_sc):
        m = model_cls(**model_kwargs).to(DEVICE)
        tr_loader = make_loader(X_sc[tr], y_np[tr])
        va_loader = make_loader(X_sc[va], y_np[va], shuffle=False)
        m = train_model(m, tr_loader, va_loader, **train_kwargs)
        r2s.append(r2_score(y_np[va], predict_np(m, X_sc[va])))
    return float(np.mean(r2s))


def evaluate_dl(name, model, model_cls, model_kwargs,
                X_tr_sc, y_tr, X_te_sc, y_te, X_all_sc, y_all, **train_kwargs):
    preds = predict_np(model, X_te_sc)
    mse   = mean_squared_error(y_te, preds)
    rmse  = np.sqrt(mse)
    r2    = r2_score(y_te, preds)

    print(f"  Test  MSE={mse:.4f}  RMSE={rmse:.4f}  R2={r2:.4f}")
    print("  Running 5-fold CV...")
    cv_r2 = cross_val_r2(model_cls, model_kwargs, X_all_sc, y_all, **train_kwargs)
    print(f"  CV R2={cv_r2:.4f}")

    torch.save(model.state_dict(), f"saved_models/{name}.pt")
    dl_results.append({
        "Model": name,
        "MSE":   round(mse,   4),
        "RMSE":  round(rmse,  4),
        "R2":    round(r2,    4),
        "CV_R2": round(cv_r2, 4)
    })


FFN_KWARGS   = dict(in_features=N_FEATURES, hidden=[256, 128, 64], dropout=0.3)
TRAIN_KWARGS = dict(epochs=200, patience=25, lr=1e-3, weight_decay=1e-4)

