        X_poly = poly.transform(X)

        # 🔥 FIX: convert feature names to string
        feature_names = poly.get_feature_names_out([str(f) for f in feature_positions])

        # SHAP explainer
        explainer = shap.LinearExplainer(lr, X_poly)
        shap_values = explainer(X_poly)

        plt.figure()
