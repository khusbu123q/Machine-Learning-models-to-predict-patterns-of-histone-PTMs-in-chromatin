F = len(FEATURE_POSITIONS)

class FFN(nn.Module):
    def __init__(self, f):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(f, 64), nn.ReLU(), nn.Dropout(0.2),
            nn.Linear(64, 32), nn.ReLU(),
            nn.Linear(32, 1)
        )
    def forward(self, x): return self.net(x)


class CNN1D(nn.Module):
    def __init__(self, f):
        super().__init__()
        self.conv = nn.Sequential(
            nn.Conv1d(1, 16, kernel_size=3, padding=1), nn.ReLU(),
            nn.Conv1d(16, 32, kernel_size=3, padding=1), nn.ReLU(),
        )
        self.fc = nn.Sequential(
            nn.Linear(32 * f, 32), nn.ReLU(),
            nn.Linear(32, 1)
        )
    def forward(self, x):
        x = self.conv(x.unsqueeze(1))
        return self.fc(x.flatten(1))


class TransformerRegressor(nn.Module):
    def __init__(self, f, d_model=32, nhead=4):
        super().__init__()
        self.embed   = nn.Linear(1, d_model)
        self.pos_emb = nn.Embedding(f, d_model)
        enc = nn.TransformerEncoderLayer(
            d_model=d_model, nhead=nhead,
            dim_feedforward=64, dropout=0.1,
            batch_first=True
        )
        self.transformer = nn.TransformerEncoder(enc, num_layers=1)
        self.head = nn.Linear(d_model * f, 1)

    def forward(self, x):
        t = self.embed(x.unsqueeze(2))
        t = t + self.pos_emb(torch.arange(x.shape[1], device=x.device))
        return self.head(self.transformer(t).flatten(1))

def train_model(model, loader, X_te, y_te_np, epochs, patience, lr):
    opt     = torch.optim.Adam(model.parameters(), lr=lr)
    loss_fn = nn.MSELoss()
    best_r2, best_preds, no_improve = -np.inf, None, 0

    for ep in range(1, epochs + 1):
        model.train()
        for xb, yb in loader:
            opt.zero_grad()
            loss_fn(model(xb), yb).backward()
            opt.step()

        model.eval()
        with torch.no_grad():
            preds = model(X_te).cpu().numpy().flatten()

        r2 = r2_score(y_te_np, preds)
        if r2 > best_r2:
            best_r2, best_preds, no_improve = r2, preds.copy(), 0
        else:
            no_improve += 1
        if no_improve >= patience:
            break

    return best_preds, best_r2

summary_results = {}
all_plot_data   = []
csv_rows        = []

total_start  = time.time()
total_combos = len(ptm_list) * len(TIMEPOINTS)
combo_idx    = 0

for ptm in ptm_list:
    summary_results[ptm] = {}

    for tp_label, tp_val in TIMEPOINTS.items():
        combo_idx += 1
        col_name = ptm if tp_val == '' else f"{ptm}.{tp_val}"

        if col_name not in df.columns:
            print(f"[{combo_idx:>3}/{total_combos}] SKIP  {ptm} {tp_label} — column missing")
            continue

        subset = df[['gene', 'gene_pos', col_name]].dropna()
        pivot  = subset.pivot_table(index='gene', columns='gene_pos', values=col_name)

        for pos in FEATURE_POSITIONS:
            if pos not in pivot.columns:
                pivot[pos] = 0

        if TARGET_POS not in pivot.columns:
            print(f"[{combo_idx:>3}/{total_combos}] SKIP  {ptm} {tp_label} — target missing")
            continue

        pivot = pivot[[TARGET_POS] + FEATURE_POSITIONS]
        pivot = pivot.dropna(subset=[TARGET_POS])
        pivot[FEATURE_POSITIONS] = pivot[FEATURE_POSITIONS].fillna(0)

        if len(pivot) < 40:
            print(f"[{combo_idx:>3}/{total_combos}] SKIP  {ptm} {tp_label} — only {len(pivot)} samples")
            continue

        X = pivot[FEATURE_POSITIONS].values.astype(np.float32)
        y = pivot[TARGET_POS].values.astype(np.float32)

        scaler   = StandardScaler()
        X_scaled = scaler.fit_transform(X).astype(np.float32)

        X_train, X_test, y_train, y_test = train_test_split(
            X_scaled, y, test_size=0.2, random_state=42
        )

        X_tr = torch.tensor(X_train)
        y_tr = torch.tensor(y_train).unsqueeze(1)
        X_te = torch.tensor(X_test)

        loader = DataLoader(TensorDataset(X_tr, y_tr), batch_size=BATCH_SIZE, shuffle=True)

        tp_res = {'ptm': ptm, 'tp': tp_label, 'y_test': y_test, 'n': len(y)}

        t0 = time.time()
        for name, model in [
            ("FFN",         FFN(F)),
            ("CNN",         CNN1D(F)),
            ("Transformer", TransformerRegressor(F)),
        ]:
            preds, r2 = train_model(model, loader, X_te, y_test, EPOCHS, PATIENCE, LR)
            rmse = np.sqrt(mean_squared_error(y_test, preds))
            tp_res[f'preds_{name}'] = preds
            tp_res[f'r2_{name}']    = r2
            tp_res[f'rmse_{name}']  = rmse

        elapsed       = time.time() - t0
        total_elapsed = time.time() - total_start
        remaining     = (total_elapsed / combo_idx) * (total_combos - combo_idx)
        print(
            f"[{combo_idx:>3}/{total_combos}] {ptm:<14} {tp_label}  "
            f"FFN=R²{tp_res['r2_FFN']:.3f}/RMSE{tp_res['rmse_FFN']:.3f}  "
            f"CNN=R²{tp_res['r2_CNN']:.3f}/RMSE{tp_res['rmse_CNN']:.3f}  "
            f"Trans=R²{tp_res['r2_Transformer']:.3f}/RMSE{tp_res['rmse_Transformer']:.3f}  "
            f"| {elapsed:.1f}s  (est. {remaining/60:.1f} min left)"
        )
        csv_rows.append({
            'PTM': ptm, 'Timepoint': tp_label,
            'FFN_R2':   round(tp_res['r2_FFN'],   4),
            'FFN_RMSE': round(tp_res['rmse_FFN'],  4),
            'CNN_R2':   round(tp_res['r2_CNN'],    4),
            'CNN_RMSE': round(tp_res['rmse_CNN'],   4),
            'Trans_R2':   round(tp_res['r2_Transformer'],   4),
            'Trans_RMSE': round(tp_res['rmse_Transformer'],  4),
        })

        summary_results[ptm][tp_label] = tp_res
        all_plot_data.append(tp_res)

pd.DataFrame(csv_rows).to_csv(CSV_OUT, index=False)
